[Unit]
Description=Calendar Kiosk Chromium
After=calendar-backend.service graphical.target
Wants=calendar-backend.service

[Service]
Type=simple
User=pi

Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=FONTCONFIG_PATH=/etc/fonts

RuntimeDirectory=calendar-kiosk

ExecStartPre=/usr/bin/curl --silent --fail http://localhost:4000

# Cache limits are 100 MiB, expressed in bytes for Chromium.
ExecStart=/usr/bin/chromium \
  --kiosk \
  --user-data-dir=/run/calendar-kiosk/chromium-profile \
  --disk-cache-dir=/run/calendar-kiosk/chromium-cache \
  --disk-cache-size=104857600 \
  --media-cache-size=104857600 \
  --noerrdialogs \
  --no-first-run \
  --disable-session-crashed-bubble \
  --disable-background-networking \
  --disable-sync \
  --password-store=basic \
  --no-default-browser-check \
  --log-level=3 \
  --autoplay-policy=no-user-gesture-required \
  --disable-vulkan \
  --use-gl=egl \
  http://localhost:4000

Restart=always
RestartSec=10

[Install]
WantedBy=graphical.target
